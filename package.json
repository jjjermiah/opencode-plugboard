{
  "name": "opencode-plugboard",
  "version": "0.22.0",
  "type": "module",
  "license": "MIT",
  "description": "Use the ChatGPT, Claude, Copilot and OpenCode Go logins in your OpenCode server from any app: an OpenCode V2 plugin serving OpenAI, Anthropic and Gemini compatible APIs.",
  "keywords": ["opencode", "opencode-plugin", "openai", "openai-compatible", "chat-completions", "responses-api", "llm-gateway", "llm-proxy"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjjermiah/opencode-plugboard.git"
  },
  "bugs": {
    "url": "https://github.com/jjjermiah/opencode-plugboard/issues"
  },
  "homepage": "https://github.com/jjjermiah/opencode-plugboard#readme",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": { "types": "./index.ts", "default": "./index.ts" },
    "./rpc": { "types": "./rpc.ts", "default": "./rpc.ts" },
    "./tui": { "types": "./tui.ts", "default": "./dist/tui.js" }
  },
  "files": ["index.ts", "rpc.ts", "tui.ts", "src/", "dist/", "README.md", "LICENSE"],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tui.json && tsc --noEmit -p test",
    "test": "bun test",
    "bench": "bun test/bench/request.bench.ts",
    "mutations": "bun .github/scripts/mutation-check.ts",
    "flake-hunt": "bun .github/scripts/flake-hunt.ts",
    "coverage-manifest": "bun .github/scripts/coverage-manifest.ts",
    "live-matrix": "bun test/live/matrix.ts",
    "compat:python": "uv run --project compat/py python compat/py/clients/run_all.py",
    "build:tui": "bun .github/scripts/build-tui.ts",
    "prepack": "bun run build:tui",
    "smoke:pack": "bun .github/scripts/smoke-pack.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "release": "bun .github/scripts/release.ts"
  },
  "dependencies": {
    "@prometheus-io/client": "0.16.1",
    "@types/escape-html": "1.0.4",
    "escape-html": "1.0.3",
    "ipaddr.js": "2.5.0",
    "lru-cache": "11.5.3",
    "p-queue": "9.3.5",
    "pino": "10.4.0",
    "safe-stable-stringify": "2.5.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/google": "4.0.93",
    "@ai-sdk/openai": "4.0.91",
    "@ai-sdk/openai-compatible": "3.0.67",
    "@anthropic-ai/sdk": "0.133.0",
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@google/genai": "2.28.0",
    "@langchain/anthropic": "1.5.12",
    "@langchain/google-genai": "2.3.2",
    "@langchain/openai": "1.6.2",
    "@opencode/plugin": "2.0.26",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/bun": "1.4.2",
    "@types/lcov-parse": "1.0.2",
    "@types/node": "^26.6.2",
    "@types/semver": "7.8.0",
    "ai": "7.0.137",
    "ajv": "8.20.0",
    "babel-preset-solid": "1.9.12",
    "conventional-commits-parser": "7.1.3",
    "effect": "4.0.0-rc.112",
    "eventsource-parser": "4.1.1",
    "fast-check": "4.10.2",
    "fast-xml-parser": "5.11.2",
    "lcov-parse": "1.0.0",
    "lefthook": "2.2.1",
    "mitata": "1.0.34",
    "openai": "7.32.0",
    "semver": "7.8.5",
    "solid-js": "1.9.15",
    "typescript": "^5.9.3",
    "vitepress": "1.6.4"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.26 <2.1",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "effect": "4.0.0-rc.112",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": { "optional": true },
    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  }
}
