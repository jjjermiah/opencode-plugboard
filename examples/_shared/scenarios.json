{
  "schema": 1,
  "routes": {
    "generate": ["/v1/chat/completions", "/v1/completions", "/v1/responses", "/v1/messages", "/v1beta/models/"],
    "models": ["/v1/models"]
  },
  "scenarios": [
    {
      "id": "S1",
      "name": "plain chat, non-stream",
      "required": true,
      "models": ["fast", "anthropic/claude-haiku-4-5", "openai/gpt-5.6-luna#low"],
      "routes": "generate",
      "prompt": "Reply with exactly: pong",
      "observes": ["text", "finish_reason", "usage"],
      "checks": [
        { "name": "answer contains pong", "path": "text", "containsAny": ["pong"] },
        { "name": "finish_reason is stop", "path": "finish_reason", "equals": "stop" },
        { "name": "usage present", "path": "usage", "present": true }
      ]
    },
    {
      "id": "S2",
      "name": "tool call, then a tool-result turn",
      "required": true,
      "models": ["fast", "anthropic/claude-haiku-4-5", "openai/gpt-5.6-luna#low"],
      "routes": "generate",
      "prompt": "What is the weather in Paris? Use the tool.",
      "observes": ["finish_reason", "tool_name", "tool_city", "tool_call_id", "final_text", "final_finish_reason"],
      "checks": [
        { "name": "turn 1 finish_reason is tool_calls", "path": "finish_reason", "equals": "tool_calls" },
        { "name": "one get_weather call", "path": "tool_name", "equals": "get_weather" },
        { "name": "city is Paris", "path": "tool_city", "containsAny": ["paris"] },
        { "name": "call id present", "path": "tool_call_id", "present": true },
        { "name": "turn 2 mentions 18 or cloudy", "path": "final_text", "containsAny": ["18", "cloudy"] },
        { "name": "turn 2 finish_reason is stop", "path": "final_finish_reason", "equals": "stop" }
      ]
    },
    {
      "id": "S3",
      "name": "streaming text, with and without usage",
      "required": true,
      "models": ["fast"],
      "routes": "generate",
      "prompt": "Reply with exactly: pong",
      "observes": ["text", "finish_reason", "usage", "done"],
      "checks": [
        { "name": "streamed text contains pong", "path": "text", "containsAny": ["pong"] },
        { "name": "finish_reason is stop", "path": "finish_reason", "equals": "stop" },
        { "name": "usage chunk present when requested", "path": "usage", "present": true },
        { "name": "stream ended normally", "path": "done", "equals": true }
      ]
    },
    {
      "id": "S4",
      "name": "streaming tool call",
      "required": true,
      "models": ["fast"],
      "routes": "generate",
      "prompt": "What is the weather in Paris? Use the tool.",
      "observes": ["finish_reason", "tool_name", "tool_city", "tool_call_id"],
      "checks": [
        { "name": "finish_reason is tool_calls", "path": "finish_reason", "equals": "tool_calls" },
        { "name": "streamed get_weather call", "path": "tool_name", "equals": "get_weather" },
        { "name": "city is Paris", "path": "tool_city", "containsAny": ["paris"] },
        { "name": "call id present", "path": "tool_call_id", "present": true }
      ]
    },
    {
      "id": "S5",
      "name": "image as data URL",
      "required": true,
      "models": ["fast", "anthropic/claude-haiku-4-5", "openai/gpt-5.6-luna#low"],
      "routes": "generate",
      "prompt": "What color is this image? One word.",
      "observes": ["text"],
      "checks": [{ "name": "answer says red", "path": "text", "containsAny": ["red"] }]
    },
    {
      "id": "S6",
      "name": "structured output",
      "required": true,
      "models": ["fast", "anthropic/claude-haiku-4-5", "openai/gpt-5.6-luna#low"],
      "routes": "generate",
      "prompt": "Estimate: 2 boiled eggs and a slice of toast.",
      "observes": ["calories", "protein_g", "extra_keys"],
      "checks": [
        { "name": "calories is a number", "path": "calories", "number": true },
        { "name": "protein_g is a number", "path": "protein_g", "number": true },
        { "name": "no extra keys", "path": "extra_keys", "equals": [] }
      ]
    },
    {
      "id": "S7",
      "name": "list models",
      "required": true,
      "models": ["-"],
      "routes": "models",
      "prompt": null,
      "observes": ["model_ids", "has_fast", "has_claude", "has_gpt_low"],
      "checks": [
        { "name": "fast listed", "path": "has_fast", "equals": true },
        { "name": "claude listed", "path": "has_claude", "equals": true },
        { "name": "gpt low variant listed", "path": "has_gpt_low", "equals": true }
      ]
    },
    {
      "id": "S8",
      "name": "traced call reaches the tracing backend",
      "required": true,
      "models": ["fast"],
      "routes": "generate",
      "prompt": "Reply with exactly: pong",
      "observes": ["trace_received", "trace_model_matches", "trace_usage_matches", "trace_output_matches"],
      "checks": [
        { "name": "generation reached the tracing backend", "path": "trace_received", "equals": true },
        { "name": "generation records the model name", "path": "trace_model_matches", "equals": true },
        { "name": "generation records the usage plugboard returned", "path": "trace_usage_matches", "equals": true },
        { "name": "generation records the answer", "path": "trace_output_matches", "equals": true }
      ]
    },
    {
      "id": "S9",
      "name": "pull request review of a local branch",
      "required": true,
      "models": ["fast"],
      "routes": "generate",
      "prompt": null,
      "observes": ["review_written", "review_has_scripted_text", "request_route", "request_model"],
      "checks": [
        { "name": "review file written", "path": "review_written", "equals": true },
        { "name": "review holds the model's text", "path": "review_has_scripted_text", "equals": true },
        { "name": "request reached chat completions", "path": "request_route", "equals": "/v1/chat/completions" },
        { "name": "request used the configured model", "path": "request_model", "equals": "fast" }
      ]
    },
    {
      "id": "S10",
      "name": "token count before a request",
      "required": true,
      "models": ["fast"],
      "routes": "generate",
      "prompt": "Reply with exactly: pong",
      "observes": ["total_tokens", "total_tokens_positive"],
      "checks": [
        { "name": "count is a number", "path": "total_tokens", "number": true },
        { "name": "count is above zero", "path": "total_tokens_positive", "equals": true }
      ]
    },
    {
      "id": "S11",
      "name": "file edit in the client's own edit format",
      "required": false,
      "models": ["fast", "anthropic/claude-haiku-4-5", "openai/gpt-5.6-luna#low"],
      "routes": "generate",
      "prompt": "Change hello.py to print: hello from plugboard",
      "observes": ["file_text", "old_line_kept"],
      "checks": [
        { "name": "file has the new line", "path": "file_text", "containsAny": ["hello from plugboard"] },
        { "name": "old line is gone", "path": "old_line_kept", "equals": false }
      ]
    },
    {
      "id": "S12",
      "name": "coding agent: several tool calls in one run",
      "required": true,
      "models": ["fast"],
      "routes": "generate",
      "prompt": "Create notes.txt containing plugboard, read it back, then say done.",
      "observes": ["tools_used", "file_content", "final_text", "is_error"],
      "checks": [
        { "name": "tools ran in order: Write, Read", "path": "tools_used", "equals": ["Write", "Read"] },
        { "name": "the file holds the written text", "path": "file_content", "containsAny": ["plugboard"] },
        { "name": "final answer arrived", "path": "final_text", "containsAny": ["done"] },
        { "name": "run ended without an error", "path": "is_error", "equals": false }
      ]
    },
    {
      "id": "S13",
      "name": "coding agent: a sub-agent makes its own model call",
      "required": true,
      "models": ["fast"],
      "routes": "generate",
      "prompt": "Ask a sub-agent for the secret word, then tell me what it said.",
      "observes": ["agent_called", "subagent_reply", "final_text", "is_error"],
      "checks": [
        { "name": "the agent tool was called", "path": "agent_called", "equals": true },
        { "name": "the sub-agent's own model call was answered", "path": "subagent_reply", "containsAny": ["marmot"] },
        { "name": "final answer carries the sub-agent's reply", "path": "final_text", "containsAny": ["marmot"] },
        { "name": "run ended without an error", "path": "is_error", "equals": false }
      ]
    },
    {
      "id": "S14",
      "name": "coding agent: compaction of a session",
      "required": true,
      "models": ["fast"],
      "routes": "generate",
      "prompt": "Remember the number 42 and say noted.",
      "observes": ["first_text", "compacted", "summary_text", "resumed_text", "is_error"],
      "checks": [
        { "name": "first turn answered", "path": "first_text", "containsAny": ["noted"] },
        { "name": "the CLI compacted the session", "path": "compacted", "equals": true },
        { "name": "the summary came from the model", "path": "summary_text", "containsAny": ["scripted summary"] },
        { "name": "the next turn saw the summary, not the old turns", "path": "resumed_text", "containsAny": ["summary only"] },
        { "name": "run ended without an error", "path": "is_error", "equals": false }
      ]
    },
    {
      "id": "E1",
      "name": "wrong key",
      "required": false,
      "models": ["fast"],
      "routes": "generate",
      "prompt": "Reply with exactly: pong",
      "observes": ["status", "code", "type"],
      "checks": [
        { "name": "status is 401", "path": "status", "equals": 401 },
        { "name": "error type is authentication_error", "path": "type", "equals": "authentication_error" },
        { "name": "code is invalid_api_key", "path": "code", "equals": "invalid_api_key" }
      ]
    },
    {
      "id": "E2",
      "name": "unknown model",
      "required": false,
      "models": ["nope"],
      "routes": "generate",
      "prompt": "Reply with exactly: pong",
      "observes": ["status", "code", "type"],
      "checks": [
        { "name": "status is 404", "path": "status", "equals": 404 },
        { "name": "error type is not_found_error", "path": "type", "equals": "not_found_error" },
        { "name": "code is model_not_found", "path": "code", "equals": "model_not_found" }
      ]
    }
  ]
}
