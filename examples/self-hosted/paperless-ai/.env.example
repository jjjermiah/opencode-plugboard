# paperless-ai with plugboard. Copy to .env next to docker-compose.yml.
# Variable names are from the upstream .env.example and config/config.js at d2fda69.

# region snippet
PAPERLESS_AI_INITIAL_SETUP=yes

PAPERLESS_API_URL=http://192.0.2.10:8000/api
PAPERLESS_API_TOKEN=<your paperless-ngx API token>
# Optional: the paperless-ngx user whose documents are processed.
PAPERLESS_USERNAME=<your paperless-ngx username>

AI_PROVIDER=custom
# The plugboard app key, not an OpenAI key.
CUSTOM_API_KEY=<the paperless-ai app key>
CUSTOM_BASE_URL=http://host.docker.internal:4010/v1
CUSTOM_MODEL=text

# SYSTEM_PROMPT is not set here. Finishing setup in the web UI writes it to data/.env.
SCAN_INTERVAL=*/30 * * * *
# endregion snippet
