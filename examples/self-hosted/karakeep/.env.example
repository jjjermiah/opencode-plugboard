# Karakeep: plugboard settings. Copy to .env next to the upstream docker-compose.yml.
# Fill in the upstream secrets too (NEXTAUTH_SECRET, MEILI_MASTER_KEY, NEXTAUTH_URL).
NEXTAUTH_SECRET=change-me
MEILI_MASTER_KEY=change-me
NEXTAUTH_URL=http://localhost:3000

# region snippet
# The plugboard app key, not an OpenAI key.
OPENAI_API_KEY=<the karakeep app key>
OPENAI_BASE_URL=http://host.docker.internal:4010/v1

# Aliases from plugboard's `aliases` option.
INFERENCE_TEXT_MODEL=tag
INFERENCE_IMAGE_MODEL=vision

# Plugboard serves no embeddings. Keep semantic search off.
SEMANTIC_SEARCH_ENABLED=false
# endregion snippet
