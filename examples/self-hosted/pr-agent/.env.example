# PR-Agent env for plugboard. Copy to .env and fill in. Never commit .env.
# region snippet
# Double underscore separates the section from the key (upstream convention).
OPENAI__API_BASE=http://192.0.2.10:4010/v1
OPENAI__KEY=<the pr-agent app key>
# endregion snippet
# Your GitHub token for the review bot. Use the Action secret, not a local file.
GITHUB_TOKEN=<github token>
