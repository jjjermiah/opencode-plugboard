# paperless-gpt with plugboard. Copy to .env next to docker-compose.yml.

# region snippet
PAPERLESS_BASE_URL=http://paperless-ngx:8000
PAPERLESS_API_TOKEN=<your paperless-ngx API token>

LLM_PROVIDER=openai
LLM_MODEL=text
LLM_LANGUAGE=English

# The plugboard app key, not an OpenAI key.
OPENAI_API_KEY=<the paperless-gpt app key>
OPENAI_BASE_URL=http://host.docker.internal:4010/v1

# LLM OCR, if you use it. The model must accept images.
VISION_LLM_PROVIDER=openai
VISION_LLM_MODEL=vision

LOG_LEVEL=info
# endregion snippet
