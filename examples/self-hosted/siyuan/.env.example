# SiYuan env for plugboard. Copy to .env and fill in. Never commit .env.
TZ=Etc/UTC
# Owner of ./workspace on the host. See "User Permissions" in the upstream README.
PUID=1000
PGID=1000
# Lock screen password. Required: without it, anyone who reaches the port has the data.
SIYUAN_ACCESS_AUTH_CODE=<change this>
# region snippet
# Plugboard, from inside the container. host.docker.internal is set in the compose file.
SIYUAN_OPENAI_API_BASE_URL=http://host.docker.internal:4010/v1
SIYUAN_OPENAI_API_KEY=<the siyuan app key>
SIYUAN_OPENAI_API_MODEL=writing
# endregion snippet
