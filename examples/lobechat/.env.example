# Plugboard app key (from the plugboard `keys` option).
OPENAI_API_KEY=<your plugboard app key>
# Plugboard base URL, with /v1. From inside the container, the host is host.docker.internal.
OPENAI_PROXY_URL=http://host.docker.internal:4010/v1
# Hide the built-in OpenAI models and show only plugboard's alias.
OPENAI_MODEL_LIST=-all,+fast
