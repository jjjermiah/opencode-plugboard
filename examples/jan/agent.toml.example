# Per-project provider for Jan Agent. Copy to the project's agent.toml under ~/.jan/projects/
# (Jan keeps it outside the repository). Keep the key in the environment, not in this file.
[provider]
name = "plugboard"
base_url = "http://127.0.0.1:4010/v1"
models = ["fast"]
# api_key comes from PLUGBOARD_API_KEY (Jan reads <PROVIDER>_API_KEY for provider "plugboard") or ~/.jan/config.toml
