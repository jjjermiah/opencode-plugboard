<Project Sdk="Microsoft.NET.Sdk">

  <!-- The harness runner for examples/openai-dotnet. Its own project, so the example's Program.cs keeps the one entry point. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same pin as examples/openai-dotnet/OpenAIDotnetExample.csproj. -->
    <PackageReference Include="OpenAI" Version="2.14.0" />
  </ItemGroup>

</Project>
