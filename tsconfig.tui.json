{
  // The TUI source is the only JSX in the repo (OpenTUI's Solid JSX). It is checked on its own so the
  // root config (src/ and index.ts, Node types, no JSX) keeps its settings. Only src/tui.tsx is
  // checked: tui.ts re-exports dist/tui.js, which exists only after `bun run build:tui`, and typecheck
  // must not depend on a build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid"
  },
  "include": ["src/tui.tsx"]
}
