{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "*.ts",
      "*.tsx",
      "*.mjs",
      "src/**/*.ts",
      "src/**/*.tsx",
      "test/**/*.ts",
      "test/**/*.tsx",
      ".github/scripts/*.ts",
      // Vendored API specs.
      "!test/fixtures/specs",
      // Generated by test/types/generate.ts from JSON.stringify output; regenerating would undo a reformat.
      "!test/types/wire.ts",
      // Each example has its own toolchain.
      "!examples",
      "!dist",
      "!docs/.vitepress/cache",
      "!docs/.vitepress/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // The code was written to about 200 columns and wrapped by hand where it read better. 200 is the width that
    // rewrites the fewest lines (140: 9.8k added lines, 160: 5.8k, 180: 3.7k, 200: 2.6k).
    "lineWidth": 200
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      // Wire shapes quote some keys and not others on purpose (`"content-type"`, `"__proto__"`).
      "quoteProperties": "preserve"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // 1100+ hits: `!` on a lookup an earlier check or a test already proved is the house style; the typechecker still guards the rest.
        "noNonNullAssertion": "off",
        // 100+ hits: string concatenation in messages and headers is the house style.
        "useTemplate": "off"
      },
      "suspicious": {
        // 30+ hits: assignment inside a condition or an arrow body is the compact form used throughout.
        "noAssignInExpressions": "off",
        // 20+ hits: callbacks of `forEach` and similar return a value as a one-line shorthand, not to be collected.
        "useIterableCallbackReturn": "off",
        // multipart.ts and history.ts match control characters on purpose (they strip or reject them).
        "noControlCharactersInRegex": "off"
      },
      "complexity": {
        // 15 hits: `(a(), b)` in the arrow bodies of one-line helpers, mostly in tests.
        "noCommaOperator": "off"
      },
      "correctness": {
        // 14 hits, mostly session/events.ts: `return handle(x)` in a void function is the one-line early exit used throughout.
        "noVoidTypeReturn": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["test/**", ".github/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            // 60 hits: test doubles and parsed JSON bodies are asserted on, not typed.
            "noExplicitAny": "off",
            // The mutation catalogue quotes source text that contains `${...}` inside plain strings.
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ],
  // Imports keep their order: it is hand-grouped (see the existing files), and sorting would add churn for no gain.
  "assist": { "enabled": false }
}
